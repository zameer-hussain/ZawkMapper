<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ZawkMapper MVC Sample</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Customers" asp-action="Index">ZawkMapper Sample</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">CRUD</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Scenarios" asp-action="LocalizedProducts">Sindhi sample</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Scenarios" asp-action="RuntimeVsProjection">Map vs Project</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Scenarios" asp-action="SalaryIncrement">Salary</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Scenarios" asp-action="PrefixSuffix">Prefix suffix</a></li>
            </ul>
            <span class="navbar-text small">MVC + EF Core + SQLite + ProjectAs + Map</span>
        </div>
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
